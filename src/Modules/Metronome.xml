<?xml version="1.0"?>
<GuiXml>
  <Controls>
    <Control name="MetronomeRhythm" virtual="true">
      <AnchorFill />
      <Controls>
        <Control name="$(parent)Frame">
          <AnchorFill />
          <Controls>
            <Texture name="$(parent)Left"
            inherits="ZO_PlayerAttributeFrameLeftArrow"></Texture>
            <Texture name="$(parent)Center"
            inherits="ZO_PlayerAttributeFrameCenter"></Texture>
            <Texture name="$(parent)Right"
            inherits="ZO_PlayerAttributeFrameRightArrow"></Texture>
          </Controls>
        </Control>
      </Controls>
    </Control>
  </Controls>
</GuiXml>
